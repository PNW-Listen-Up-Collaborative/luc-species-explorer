# Source acoustic data. These are inputs to build_cache.py, not products of it,
# and they are far too large for git: Combined_BirdNET_Results.csv alone is
# 78 MB, against GitHub's 50 MB warning and 100 MB hard limit. Committing them
# would bloat every future clone permanently, since git keeps all history.
# Keep them in Box/Drive alongside the repo and rebuild the cache locally.
Combined_BirdNET_Results.csv
BirdNET_Recording_Species_Summary.csv
BirdNET_Recording_Manifest.csv
GPC_Metadata.csv
Nb3_BirdNET_Results_Exploration.ipynb

# Design handoff archive.
BirdNET Data Toggle Dashboard.zip

# Python bytecode.
__pycache__/
*.py[cod]

# Streamlit local secrets, if any are ever added.
.streamlit/secrets.toml

# NOTE: data/ is deliberately NOT ignored. It is generated by build_cache.py,
# but it is only ~92 KB and it is what makes the app runnable straight from a
# clone without the multi-gigabyte source CSVs. It is also the exact cache the
# verification suite was last run against, so committing it keeps results
# reproducible.
